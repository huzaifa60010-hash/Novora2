rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasVerifiedEmail() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true;
    }

    function adminConfigDoc() {
      return get(/databases/$(database)/documents/settings/adminConfig);
    }

    // Dynamic Admin clearance: checks Firestore settings/adminConfig.authorizedAdminEmails,
    // falling back to the bootstrap owner email only when adminConfig has not been created yet.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (hasVerifiedEmail() && (
          (exists(/databases/$(database)/documents/settings/adminConfig) &&
           adminConfigDoc().data.authorizedAdminEmails is list &&
           request.auth.token.email.lower() in adminConfigDoc().data.authorizedAdminEmails) ||
          (!exists(/databases/$(database)/documents/settings/adminConfig) &&
           request.auth.token.email.lower() == 'huzaifa60010@gmail.com')
        ))
      );
    }

    function isValidOrderCreate() {
      return request.resource.data.userId == request.auth.uid &&
        request.resource.data.orderNumber is string &&
        request.resource.data.orderNumber.size() > 0 &&
        request.resource.data.customer is map &&
        request.resource.data.deliveryAddress is map &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0;
    }

    // Customer profiles: users can only read/write their own permitted fields and cannot self-assign or escalate admin role
    function isAllowedUserWriteKeys() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'fullName',
        'email',
        'phone',
        'photoURL',
        'authProvider',
        'emailVerified',
        'savedAddresses',
        'wishlist',
        'createdAt',
        'updatedAt',
        'lastLoginAt',
        'role'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        isAllowedUserWriteKeys() &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer')
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        isAllowedUserWriteKeys() &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Orders: buyers can create & update their own payment-pending orders (or read own), admins manage all
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (hasVerifiedEmail() && resource.data.accountEmail == request.auth.token.email.lower())
      ));
      allow create: if isAuthenticated() && isValidOrderCreate();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    // Payment transactions: customers can record their own card checkout tx; admins manage all
    match /paymentTransactions/{txId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.orderId is string;
      allow update, delete: if isAdmin();
    }

    // Authenticated storefront catalog: visitors must authenticate before accessing catalog data
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /storeImages/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Checkout gateway settings (authenticated customers read public gateway metadata; admins write)
    match /settings/paymentGateway {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Storefront pricing, currency, tax, and shipping rules (non-sensitive display config; admins write)
    match /settings/pricingConfig {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dynamic Admin allowlist & Drive ownership config (only verified Admin can read/update; min 1 email required)
    match /settings/adminConfig {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['authorizedAdminEmails']) &&
        request.resource.data.authorizedAdminEmails is list &&
        request.resource.data.authorizedAdminEmails.size() >= 1 &&
        request.resource.data.authorizedAdminEmails.size() <= 10;
      allow delete: if false;
    }

    // Admin configuration restricted strictly to verified administrator
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
