@echo off
setlocal EnableExtensions
title NOVORA E-Commerce - Universal Browser Launcher

cd /d "%~dp0"

echo ===================================================
echo             NOVORA E-COMMERCE STORE
echo       Full-Stack Browser Launcher (Port 3000)
echo ===================================================
echo.

echo [1/4] Checking Node.js installation...
where node >nul 2>&1
if errorlevel 1 (
    echo.
    echo ERROR: Node.js was not found on your system.
    echo Node.js LTS is required to run NOVORA.
    echo.
    echo Please download and install Node.js LTS from:
    echo https://nodejs.org/
    echo.
    echo After installing Node.js, open a new Command Prompt and run OPEN-NOVORA.bat again.
    pause
    exit /b 1
)

for /f "delims=" %%V in ('node --version') do echo Node.js detected: %%V

echo.
echo [2/4] Verifying project dependencies...
set "NEED_INSTALL=0"
if not exist "node_modules" set "NEED_INSTALL=1"
if not exist "node_modules\.bin\vite.cmd" set "NEED_INSTALL=1"
if not exist "node_modules\.bin\tsx.cmd" set "NEED_INSTALL=1"

if "%NEED_INSTALL%"=="1" (
    echo Installing required project packages ^(including Vite and TSX^)...
    set "NODE_ENV="
    call npm install --include=dev
    if errorlevel 1 (
        echo.
        echo ERROR: Package installation failed. Check internet connection and try again.
        pause
        exit /b 1
    )
) else (
    echo All required dependencies are installed.
)

echo.
echo [3/4] Compiling NOVORA production bundle...
set "NODE_ENV="
call npm run build
if errorlevel 1 (
    echo.
    echo ERROR: Production build failed. Check the error messages above.
    pause
    exit /b 1
)

if not exist "dist\index.html" (
    echo.
    echo ERROR: dist\index.html was not generated by Vite build.
    pause
    exit /b 1
)

echo.
echo [4/4] Starting NOVORA full-stack server...
set "NOVORA_PORT=3000"
for /f "usebackq delims=" %%P in (`node -e "const n=require('net');const t=p=>new Promise(r=>{const s=n.createServer();s.once('error',()=>r(0));s.once('listening',()=>s.close(()=>r(1)));s.listen(p,'0.0.0.0');});(async()=>{for(let p=3000;p!==3011;p++){if(await t(p)){console.log(p);process.exit(0);}}console.log(3000);})();"`) do set "NOVORA_PORT=%%P"

if not "%NOVORA_PORT%"=="3000" (
    echo Port 3000 is currently busy. Launching NOVORA on http://localhost:%NOVORA_PORT% instead.
)

set "PORT=%NOVORA_PORT%"
set "NODE_ENV=production"

echo Waiting for server to start, then opening http://localhost:%NOVORA_PORT% in your browser...
start "" /b node -e "const h=require('http'),cp=require('child_process'),p=process.env.PORT?process.env.PORT:'3000',u='http://localhost:'+p;let i=0;const iv=setInterval(()=>{i++;if(i===90){clearInterval(iv);return;}const r=h.get('http://127.0.0.1:'+p+'/api/products',s=>{s.resume();clearInterval(iv);cp.execFile('cmd.exe',['/c','start','',u]);});r.on('error',()=>{});r.setTimeout(1000,()=>r.destroy());},400);"

echo.
echo ===================================================
echo NOVORA is starting at: http://localhost:%NOVORA_PORT%
echo Browser will open automatically once the server is ready.
echo Keep this window open while browsing the store.
echo Press Ctrl+C to stop the server when finished.
echo ===================================================
echo.

call npm run start

if errorlevel 1 (
    echo.
    echo Server process stopped with an exit code. Review the errors above.
    pause
)
